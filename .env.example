# --- Django core ---
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.sqlite3


# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=devmailsend26@gmail.com
EMAIL_HOST_PASSWORD=lldo mcls jlqy nmnw
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AeroFlow <no-reply@aeroflow.example.com>

# --- Business configuration defaults (also editable from Admin > System Settings) ---
DELAY_RECOVERY_THRESHOLD_MINUTES=120
