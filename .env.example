# ==========================================================
# AeroFlow - Environment Configuration Example
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# --- Django core ---
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Default: SQLite, no server required, database file created automatically
# at the project root (db.sqlite3). Leave DB_NAME unset for SQLite so it
# resolves to that path regardless of where you run manage.py from.
DB_ENGINE=django.db.backends.sqlite3

# To use MySQL instead, comment out the line above and uncomment below:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=aeroflow_db
# DB_USER=aeroflow_user
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- Email (SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=AeroFlow <no-reply@aeroflow.example.com>

# --- Business configuration defaults (also editable from Admin > System Settings) ---
DELAY_RECOVERY_THRESHOLD_MINUTES=120
